      },
      "items": [
        {
          "info": {
            "name": "Deliverect Get Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.deliverect.com/loyalty/:channelLinkId/configuration",
            "params": [
              {
                "name": "channelLinkId",
                "value": "5e8abc11dec0001a009b",
                "type": "path",
                "description": "The channelLinkId value."
              }
            ]
